{
  "files.associations": {
    "*.mdx": "markdown"
  },
  "markdown.copyFiles.destination": {
    "**/*.{md,mdx}": "/static/img/${documentBaseName}-${fileName}"
  },
  "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
  "markdown.editor.filePaste.enabled": true,
  "pasteImage.path": "${projectRoot}/static/img",
  "pasteImage.basePath": "${projectRoot}/static",
  "pasteImage.prefix": "/",
  "pasteImage.forceUnixStyleSeparator": true,
  "pasteImage.encodePath": "urlEncodeSpace",
  "pasteImage.namePrefix": "${currentFileNameWithoutExt}-",
  "pasteImage.insertPattern": "![${imageFileNameWithoutExt}](${imageFilePath})"
}
