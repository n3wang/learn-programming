DOCKER_DIR ?= /root/docker

.PHONY: docker-build docker-up docker-logs docker-publish

docker-build:
	docker compose -f $(DOCKER_DIR)/docker-compose.yml build learn

docker-up:
	docker compose -f $(DOCKER_DIR)/docker-compose.yml up -d --build learn caddy

docker-logs:
	docker compose -f $(DOCKER_DIR)/docker-compose.yml logs -f --tail=200 learn caddy

docker-publish: docker-up
	@echo "Published: https://learn.l.l0l.in"
