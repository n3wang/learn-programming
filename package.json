{
  "name": "learn-programming",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port ${PORT:-7001}",
    "build": "NODE_OPTIONS=--max-old-space-size=12288 docusaurus build --locale en",
    "build:biancheng": "DOC_BUILD=biancheng DOC_BUILD_MINIMAL=1 npm run build",
    "build:exclude-fundamentals": "DOC_BUILD_EXCLUDE=fundamentals npm run build",
    "build:fundamentals": "DOC_BUILD=fundamentals DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-ce": "DOC_BUILD=fundamentals DOC_FUND_ONLY=computer-engineering DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-algo": "DOC_BUILD=fundamentals DOC_FUND_ONLY=algorithms DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-scale": "DOC_BUILD=fundamentals DOC_FUND_ONLY=scalable-systems DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-engine": "DOC_BUILD=fundamentals DOC_FUND_ONLY=game-engine-development DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-half-a": "DOC_BUILD=fundamentals DOC_FUND_ONLY=computer-engineering,algorithms DOC_BUILD_MINIMAL=1 npm run build",
    "build:fund-half-b": "DOC_BUILD=fundamentals DOC_FUND_ONLY=scalable-systems,game-engine-development,artificial-intelligence DOC_BUILD_MINIMAL=1 npm run build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve --port ${PORT:-7001}",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "clsx": "^1.1.1",
    "codemirror": "^6.0.2",
    "docusaurus-plugin-image-zoom": "^2.0.0",
    "framework7-react": "^7.0.4",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-flashcard": "^1.0.2",
    "react-image-gallery": "^1.2.8",
    "rehype-katex": "7",
    "remark-math": "6",
    "swiper": "^8.1.6",
    "three": "^0.185.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
