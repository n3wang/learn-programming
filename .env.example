# Piston code-execution API
#
# Defaults (no env needed):
#   npm start  → http://127.0.0.1:2000/api/v2/execute
#   npm run build → https://piston.l.l0l.in/api/v2/execute
#
# Optional overrides:
# PISTON_EXECUTE_URL=https://piston.l.l0l.in/api/v2/execute
# PISTON_HOST=http://127.0.0.1
# PISTON_PORT=2000
