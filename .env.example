# Piston code-execution API
#
# Defaults (no env needed):
#   npm start  → http://127.0.0.1:2000/api/v2/execute when local Piston is up,
#                otherwise https://piston.l.l0l.in/api/v2/execute
#   npm run build → https://piston.l.l0l.in/api/v2/execute
# Browser fetch also retries the deployed URL if local is unreachable.
#
# Optional overrides:
# PISTON_EXECUTE_URL=https://piston.l.l0l.in/api/v2/execute
# PISTON_HOST=http://127.0.0.1
# PISTON_PORT=2000

# Spring Boot classroom API (rosters / day-stats / game-packs / drafts)
# Local: npm start defaults to http://localhost:8080
# Docker compose API on host 8081 → API_BASE_URL=http://localhost:8081
# Production deploy: MUST set the public HTTPS origin of springbackend
# API_BASE_URL=https://api.example.com
API_BASE_URL=http://localhost:8080
