  "cards": [
    {
      "id": "io-inventory-policy",
      "term": "Inventory policy",
      "definition": "Rule that decides when to replenish and how much to order, e.g. (s, Q) or (R, S).",
      "example": "Our policy: review every Monday and order up to 400 units.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "库存策略",
          "definition": "决定何时补货以及订多少的规则，如 (s, Q) 或 (R, S)。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/2897/2897785.png"
    },
    {
      "id": "io-continuous-review",
      "term": "Continuous review",
      "definition": "Inventory is monitored all the time and an order can be placed the moment a threshold is crossed.",
      "example": "The ERP triggers a purchase order as soon as stock hits the reorder point.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "连续盘点",
          "definition": "持续监控库存，一旦触及阈值即可立即下单。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/10397/10397255.png",
      "imageQuery": "live monitoring dashboard"
    },
    {
      "id": "io-periodic-review",
      "term": "Periodic review",
      "definition": "Inventory is checked only at fixed intervals R, and orders can be placed only at those review times.",
      "example": "The buyer reviews stock every two weeks and orders then.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "定期盘点",
          "definition": "仅在固定间隔 R 检查库存，并只能在盘点时下单。"
        }
      },
      "image": "https://ecdn.teacherspayteachers.com/thumbitem/PERIODIC-INVENTORY-SYSTEM-Lesson-Assignment-Intro-to-Accounting--13878875-1751751036/large-13878875-1.jpg"
    },
    {
      "id": "io-reorder-point",
      "term": "Reorder point (s)",
      "definition": "Inventory-position threshold that triggers a new order under continuous review.",
      "example": "With s = 120, an order goes out when position drops to 120.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "再订货点 (s)",
          "definition": "连续盘点下触发新订单的库存位置阈值。"
        }
      },
      "image": "https://www.transtek.com/wp-content/uploads/2025/01/Reorder-Points-1.png"
    },
    {
      "id": "io-order-up-to-level",
      "term": "Order-up-to level (S)",
      "definition": "Target inventory position: each order raises the position back to S.",
      "example": "Position 150, S = 400 → order 250.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "订货至水平 (S)",
          "definition": "目标库存位置：每次订货使库存位置回升至 S。"
        }
      },
      "image": "https://www.jestais.com/wp-content/uploads/new15.png"
    },
    {
      "id": "io-sq-policy",
      "term": "(s, Q) policy",
      "definition": "Continuous review; when position falls to s or below, order a fixed quantity Q.",
      "example": "Order 500 units whenever position hits 120.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "(s, Q) 策略",
          "definition": "连续盘点；库存位置降至 s 或以下时，订购固定数量 Q。"
        }
      },
      "imageQuery": "reorder fixed quantity",
      "image": "https://cdn-icons-png.flaticon.com/128/5331/5331779.png"
    },
    {
      "id": "io-rs-policy",
      "term": "(R, S) policy",
      "definition": "Periodic review every R periods; order the amount that brings position up to S.",
      "example": "Every 7 days, order up to 400.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "(R, S) 策略",
          "definition": "每 R 期盘点一次；订购使库存位置达到 S 的数量。"
        }
      },
      "imageQuery": "calendar refill",
      "image": "https://cdn-icons-png.flaticon.com/128/18999/18999124.png"
    },
    {
      "id": "io-ss-policy",
      "term": "(s, S) policy",
      "definition": "When position falls to s or below, order up to S; combines a trigger with a target.",
      "example": "Below 120, order up to 400.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "(s, S) 策略",
          "definition": "库存位置降至 s 或以下时订货至 S；将触发点与目标结合。"
        }
      },
      "imageQuery": "min max inventory",
      "image": "https://ts1.mm.bing.net/th?id=OIP.34nwBM7mZMdgXCqtEr7VpAAAAA&pid=15.1"
    },
    {
      "id": "io-on-hand",
      "term": "On-hand inventory",
      "definition": "Physical stock available in the warehouse right now.",
      "example": "230 units on the shelf.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "现有库存",
          "definition": "仓库中当前实际可用的库存。"
        }
      },
      "image": "https://ts1.mm.bing.net/th?id=OIP.RqWfKyNY_qZI0QAmM5lL2wAAAA&pid=15.1"
    },
    {
      "id": "io-on-order",
      "term": "On-order (in-transit) inventory",
      "definition": "Units ordered but not yet received.",
      "example": "Two trucks with 300 units are on the road.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/policies-with-safety-stock",
      "translations": {
        "zh-Hans": {
          "term": "在途库存",
          "definition": "已下单但尚未收到的数量。"
        }
      },
      "image": "https://ts4.mm.bing.net/th?id=OIP.Sz1-ifp-MeHSZSVRKdSvIgAAAA&pid=15.1"
    },
    {
      "id": "io-backorder",
      "term": "Backorder",
      "definition": "Demand that could not be served immediately but will be filled later when stock arrives.",
      "example": "The customer waits; the order ships next week.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/inventory-policies",
      "translations": {
        "zh-Hans": {
          "term": "缺货待补",
          "definition": "未能立即满足、待到货后再补发的需求。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/7875/7875876.png"
    },
    {
      "id": "io-lost-sales",
      "term": "Lost sales",
      "definition": "Unmet demand that disappears — the customer buys elsewhere.",
      "example": "Empty shelf: the shopper leaves and the sale is gone.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/policies-with-safety-stock",
      "translations": {
        "zh-Hans": {
          "term": "销售损失",
          "definition": "未满足的需求流失——顾客转向别处购买。"
        }
      },
      "image": "https://ts1.mm.bing.net/th?id=OIP.vGT7S1RynwT6dNz4eyAxmAAAAA&pid=15.1"
    },
    {
      "id": "io-inventory-position",
      "term": "Inventory position",
      "definition": "On-hand + on-order − backorders; the quantity ordering decisions are based on.",
      "example": "200 on hand + 300 on order − 50 backordered = 450.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/when-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "库存位置",
          "definition": "现有库存 + 在途库存 − 缺货待补；订货决策所依据的量。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/2897/2897785.png"
    },
    {
      "id": "io-lead-time",
      "term": "Lead time (L)",
      "definition": "Time between placing an order and receiving it.",
      "example": "The supplier needs 3 weeks from PO to delivery.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/when-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "提前期 (L)",
          "definition": "从下单到收货之间的时间。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/10614/10614880.png"
    },
    {
      "id": "io-review-period",
      "term": "Review period (R)",
      "definition": "Time between two inventory reviews under periodic review.",
      "example": "Weekly review: R = 1 week.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/when-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "盘点周期 (R)",
          "definition": "定期盘点下两次库存检查之间的时间。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/4127/4127130.png"
    },
    {
      "id": "io-risk-period",
      "term": "Risk period",
      "definition": "Window an order must cover before the next order can arrive: L under continuous review, R + L under periodic review.",
      "example": "R = 1 week, L = 2 weeks → risk period 3 weeks.",
      "category": "international-business/inventory-optimization/policies",
      "link": "/fundamentals/international-business/inventory-optimization/when-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "风险期",
          "definition": "在下一批订货到达前本次订货须覆盖的时段：连续盘点为 L，定期盘点为 R + L。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/13479/13479906.png"
    },
    {
      "id": "io-eoq",
      "term": "Economic order quantity (EOQ)",
      "definition": "Order size that minimises ordering plus holding cost under steady demand: Q* = √(2KD/h).",
      "example": "K = 50, D = 10,000, h = 2 → Q* ≈ 707.",
      "category": "international-business/inventory-optimization/quantities",
      "link": "/fundamentals/international-business/inventory-optimization/how-much-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "经济订货批量 (EOQ)",
          "definition": "在稳定需求下使订货成本与持有成本之和最小的订货量：Q* = √(2KD/h)。"
        }
      },
      "image": "https://ts2.mm.bing.net/th?id=OIP.SKXvpwq9Mxda0jQEq8yH9QAAAA&pid=15.1"
    },
    {
      "id": "io-ordering-cost",
      "term": "Ordering cost (K)",
      "definition": "Fixed cost per order regardless of size: admin, transport, setup.",
      "example": "Each PO costs 50 to process and ship.",
      "category": "international-business/inventory-optimization/quantities",
      "link": "/fundamentals/international-business/inventory-optimization/how-much-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "订货成本 (K)",
          "definition": "与订货量无关的每次订货固定成本：行政、运输、准备等。"
        }
      },
      "image": "https://ts4.mm.bing.net/th?id=OIP.enQFIGGQGFBTgfy8hW9sJgAAAA&pid=15.1"
    },
    {
      "id": "io-holding-cost",
      "term": "Holding cost (h)",
      "definition": "Cost of keeping one unit in stock for one period: capital, storage, insurance, obsolescence.",
      "example": "h = 20% of unit value per year.",
      "category": "international-business/inventory-optimization/quantities",
      "link": "/fundamentals/international-business/inventory-optimization/how-much-should-i-order",
      "translations": {
        "zh-Hans": {
          "term": "持有成本 (h)",
          "definition": "一单位库存保存一个周期的成本：资金、仓储、保险、过时等。"
        }
      },
      "image": "https://ts3.mm.bing.net/th?id=OIP.3NC3iVPRpKjEEB2p9Obx-gAAAA&pid=15.1"
    },
    {
      "id": "io-cycle-stock",
      "term": "Cycle stock",
      "definition": "Inventory that exists because orders come in batches; averages about Q/2.",
      "example": "Ordering 700 at a time gives ~350 cycle stock.",
      "category": "international-business/inventory-optimization/quantities",
      "link": "/fundamentals/international-business/inventory-optimization/policies-with-safety-stock",
      "translations": {
        "zh-Hans": {
          "term": "周期库存",
          "definition": "因批量订货而存在的库存，平均约为 Q/2。"
        }
      },
      "imageQuery": "stock cycle",
      "image": "https://cdn-icons-png.flaticon.com/128/2550/2550561.png"
    },
    {
      "id": "io-order-batching",
      "term": "Order batching",
      "definition": "Grouping demand into larger, less frequent orders; one cause of the bullwhip effect.",
      "example": "Monthly orders amplify demand swings upstream.",
      "category": "international-business/inventory-optimization/quantities",
      "link": "/fundamentals/international-business/inventory-optimization/multi-echelon-inventory",
      "translations": {
        "zh-Hans": {
          "term": "批量订货",
          "definition": "将需求合并为较大、较少的订单；牛鞭效应成因之一。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/3676/3676505.png"
    },
    {
      "id": "io-safety-stock",
      "term": "Safety stock",
      "definition": "Extra inventory held to absorb demand (and lead-time) variability during the risk period.",
      "example": "z = 1.65, σ over risk period = 40 → about 66 units.",
      "category": "international-business/inventory-optimization/safety-stock",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "安全库存",
          "definition": "为吸收风险期内需求（及提前期）波动而额外持有的库存。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/2897/2897785.png"
    },
    {
      "id": "io-safety-factor",
      "term": "Safety factor (z)",
      "definition": "Number of standard deviations of risk-period demand held as safety stock; set from the target service level.",
      "example": "95% cycle service → z ≈ 1.65.",
      "category": "international-business/inventory-optimization/safety-stock",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "安全系数 (z)",
          "definition": "以风险期需求标准差计的安全库存倍数，由目标服务水平决定。"
        }
      },
      "imageQuery": "safety margin",
      "image": "https://cdn-icons-png.flaticon.com/128/2345/2345547.png"
    },
    {
      "id": "io-demand-std",
      "term": "Demand standard deviation (σ)",
      "definition": "Spread of demand per period; scales with √(periods) over the risk period if periods are independent.",
      "example": "σ = 20/day over 9 days → 60.",
      "category": "international-business/inventory-optimization/safety-stock",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "需求标准差 (σ)",
          "definition": "每期需求的离散程度；若各期独立，风险期内按 √期数 放大。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/14771/14771247.png",
      "imageQuery": "standard deviation icon"
    },
    {
      "id": "io-undershoot",
      "term": "Undershoot",
      "definition": "How far inventory position falls below the reorder point when a large demand crosses it.",
      "example": "Position jumps from 125 to 90: undershoot 30 below s = 120.",
      "category": "international-business/inventory-optimization/safety-stock",
      "link": "/fundamentals/international-business/inventory-optimization/policies-with-safety-stock",
      "translations": {
        "zh-Hans": {
          "term": "下冲量",
          "definition": "大额需求越过再订货点时，库存位置低于再订货点的幅度。"
        }
      },
      "imageQuery": "below threshold",
      "image": "https://cdn-icons-png.flaticon.com/128/12517/12517064.png"
    },
    {
      "id": "io-cycle-service-level",
      "term": "Cycle service level",
      "definition": "Probability of no stockout during a replenishment cycle.",
      "example": "95% of cycles end without running out.",
      "category": "international-business/inventory-optimization/service",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "周期服务水平",
          "definition": "一个补货周期内不发生缺货的概率。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/2550/2550561.png"
    },
    {
      "id": "io-period-service-level",
      "term": "Period service level",
      "definition": "Share of periods (e.g. days) without a stockout.",
      "example": "Stock-outs on 3 of 100 days → 97%.",
      "category": "international-business/inventory-optimization/service",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "期间服务水平",
          "definition": "未发生缺货的期间（如天）所占比例。"
        }
      },
      "image": "https://cdn-icons-png.flaticon.com/128/4127/4127130.png"
    },
    {
      "id": "io-fill-rate",
      "term": "Fill rate",
      "definition": "Share of demanded units served immediately from stock.",
      "example": "9,800 of 10,000 units shipped from shelf → 98%.",
      "category": "international-business/inventory-optimization/service",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "订单满足率",
          "definition": "需求数量中由库存立即满足的比例。"
        }
      },
      "image": "https://ts1.mm.bing.net/th?id=OIP.FnUPpTpGhRPF36nJ8bp2GgAAAA&pid=15.1"
    },
    {
      "id": "io-otif",
      "term": "OTIF",
      "definition": "On Time In Full — share of customer orders delivered complete and on the promised date.",
      "example": "Retailers fine suppliers whose OTIF drops below 95%.",
      "category": "international-business/inventory-optimization/service",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "准时足量交付 (OTIF)",
          "definition": "按承诺日期完整交付的客户订单比例。"
        }
      },
      "imageQuery": "on time delivery",
      "image": "https://ts1.mm.bing.net/th?id=OIP.uSBfLwRCJhd4MHknmghfwQAAAA&pid=15.1"
    },
    {
      "id": "io-normal-demand",
      "term": "Normal demand model",
      "definition": "Approximates demand with a bell curve defined by mean and σ; can give negative values and miss skew.",
      "example": "Fine for steady, high-volume items.",
      "category": "international-business/inventory-optimization/demand",
      "link": "/fundamentals/international-business/inventory-optimization/safety-stocks",
      "translations": {
        "zh-Hans": {
          "term": "正态需求模型",
          "definition": "用均值和标准差定义的钟形曲线近似需求；可能出现负值并忽略偏态。"
        }
      },
      "imageQuery": "bell curve",
      "image": "https://cdn-icons-png.flaticon.com/128/7665/7665183.png"
